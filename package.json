{
  "name": "meeplego",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_DISABLE_ESLINT=1 next build",
    "start": "next start",
    "lint": "next lint",
    "lint:legacy": "node scripts/development-tools/check-legacy-imports.mjs",
    "lint:archived": "node scripts/development-tools/check-archived-imports.mjs",
    "lint:fix": "next lint --fix",
    "lint:stories": "node scripts/development-tools/check-empty-stories.mjs",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "backfill:honors": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfill_honor_categories.ts",
    "backfill:taglines": "node scripts/backfill_bgg_taglines.js",
    "backfill:bgg-extended": "node scripts/backfill_bgg_extended.js",
    "backfill:all": "node scripts/backfill_all_metadata.js",
    "sync:bgg-trends": "node scripts/sync_bgg_trends.js",
    "sync:bgg-trends:pw": "node scripts/sync_bgg_trends_playwright.js",
    "cache:images": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/cache_game_images.ts",
    "admin:reset": "node scripts/admin_reset_password.cjs",
    "test": "vitest run",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/supabase.generated.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-once-uploaded || echo 'Chromatic optional'",
    "e2e": "playwright test",
    "e2e:open": "playwright test --ui",
    "test:email": "node scripts/deployment/test-email-deliverability.js"
  },
  "keywords": [
    "board games",
    "ranking",
    "nextjs",
    "supabase"
  ],
  "author": "Greg Robleto",
  "license": "MIT",
  "description": "A full-stack board game ranking and management app",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.53.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "fast-levenshtein": "^3.0.0",
    "fast-xml-parser": "^4.5.3",
    "fuse.js": "^7.1.0",
    "gsap": "^3.13.0",
    "next": "^15.4.6",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/addon-onboarding": "^9.1.3",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/addon-vitest": "^9.1.3",
    "@storybook/nextjs-vite": "^9.1.3",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^9.1.3",
    "jsdom": "^24.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "storybook": "^9.1.3",
    "ts-node": "^10.9.2",
    "vitest": "^3.2.4"
  }
}
