# MeepleGo Environment Variables
# Copy this file to .env.local and fill in your actual values

# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_ID=your_supabase_project_id

# BGG API
BGG_USERNAME=your_bgg_username
BGG_PASSWORD=your_bgg_password

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_url
# Sentry additional config
SENTRY_ORG=your_sentry_organization
SENTRY_PROJECT=your_sentry_project

# Analytics (Umami)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id
NEXT_PUBLIC_UMAMI_URL=https://your-umami-instance.com

# Optional: Additional analytics providers
# NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_id
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Development
NODE_ENV=development

# Deployment (automatically set by Vercel)
# VERCEL_URL=
# NEXT_PUBLIC_VERCEL_URL=
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=