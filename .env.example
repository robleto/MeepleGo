# MeepleGo Environment Variables
# Copy this file to .env.local for local development

# ===================================
# Supabase Configuration (Required)
# ===================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===================================
# Site Configuration (Required)
# ===================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ===================================
# Authentication Configuration
# ===================================
NEXT_PUBLIC_AUTH_REDIRECT_BASE=http://localhost:3000

# ===================================
# Analytics (Optional)
# ===================================
# Enable analytics tracking in development (default: only in production)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Umami Analytics (recommended)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id
# NEXT_PUBLIC_UMAMI_SRC=https://analytics.yourdomain.com/script.js

# Plausible Analytics (alternative)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Custom analytics endpoint (if needed)
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://your-analytics-endpoint.com/events

# ===================================
# Error Tracking (Optional)
# ===================================
# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable Sentry in development (default: only in production)
# NEXT_PUBLIC_SENTRY_ENABLED=true

# Sentry additional configuration
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=meeplego
# SENTRY_AUTH_TOKEN=your-auth-token

# ===================================
# Other Optional Configuration
# ===================================
# Supabase Project ID (for type generation)
# SUPABASE_PROJECT_ID=your-project-id
